# =====================================================================
# youtube-transcript-mcp configuration
# Copy to .env and adjust. Every value has a sensible default.
# =====================================================================

# --- Transcription engine -------------------------------------------
# faster-whisper (default, local) | openai-compatible (Whisper API) | none
TRANSCRIPTION_PROVIDER=faster-whisper

# faster-whisper model: tiny, base, small, medium, large-v3
# CPU: tiny/base/small are practical. GPU: medium/large-v3.
WHISPER_MODEL=small

# auto | cpu | cuda  (auto = use CUDA when available, else CPU)
DEVICE=auto

# auto | int8 | int8_float16 | float16 | float32
# auto = float16 on GPU, int8 on CPU
COMPUTE_TYPE=auto

# Whisper decoding quality vs speed
WHISPER_BEAM_SIZE=5
# Filter non-speech (improves timestamps on music-heavy videos)
WHISPER_VAD_FILTER=true

# --- OpenAI-compatible Whisper API (optional, NOT used by default) ---
# Any endpoint implementing POST /audio/transcriptions (OpenAI, Groq, etc.)
# Chat-LLM keys (DeepSeek, Grok) are NOT speech APIs and cannot be used here.
# WHISPER_API_BASE_URL=https://api.openai.com/v1
# WHISPER_API_KEY=
# WHISPER_API_MODEL=whisper-1

# --- Caption-first behavior -----------------------------------------
# Use existing YouTube captions when available (huge time saver)
PREFER_CAPTIONS=true
# Comma-separated language fallbacks when video language is unavailable
LANGUAGE_FALLBACKS=en

# --- Storage ----------------------------------------------------------
CACHE_ENABLED=true
CACHE_DIR=./data/cache
# Delete cached transcripts older than N days
CACHE_TTL_DAYS=30
# Evict oldest entries beyond this count
MAX_CACHE_ENTRIES=1000
TEMP_DIR=./data/tmp

# --- Limits / safety ---------------------------------------------------
# Seconds (4 hours)
MAX_VIDEO_DURATION=14400
MAX_DOWNLOAD_SIZE_MB=4096
# Hard cap on tool response size (chars) before truncating with a notice
MAX_RESPONSE_CHARS=60000

# --- Timeouts (seconds) ------------------------------------------------
HTTP_TIMEOUT=30
METADATA_TIMEOUT=45
CAPTION_TIMEOUT=90
AUDIO_DOWNLOAD_TIMEOUT=1800
TRANSCRIPTION_TIMEOUT=7200

# --- Optional features (architecture exists, off by default) ------------
ENABLE_DIARIZATION=false
ENABLE_SEMANTIC_SEARCH=false

# --- Server --------------------------------------------------------------
LOG_LEVEL=INFO
# stdio (for MCP clients) | sse | streamable-http
MCP_TRANSPORT=stdio
